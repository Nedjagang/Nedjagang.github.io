---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const email = SITE.email.replace('mailto:', '');
---

<BaseLayout
  title={`${SITE.name} — ${SITE.role}`}
  description={SITE.description}
  hideFooter
>
  <section class="pt-10 sm:pt-16 pb-10">
    <div class="flex items-start justify-between gap-8">
      <div class="rise">
        <p class="eyebrow mb-4">{SITE.location}</p>
        <h1 class="display text-4xl sm:text-5xl leading-tight" style="color: var(--ink);">
          I'm Praneeth — I build AI agents<br />
          <span class="lilt">and the <span class="mark">infrastructure</span> they run on.</span>
        </h1>
      </div>
      <button id="avatar" class="avatar shrink-0 rise rise-2" aria-label="Hello there">
        <span class="avatar-ring" aria-hidden="true"></span>
        {/* Identicon-style 5x5 grid, mirrored for symmetry — but the seed is the current timestamp, not the name, so it's re-derived and redrawn every second. */}
        <svg id="avatar-grid" class="avatar-grid" viewBox="0 0 144 144" width="144" height="144" aria-hidden="true">
          <rect width="144" height="144" fill="#0a111f" />
          {Array.from({ length: 25 }, (_, i) => {
            const row = Math.floor(i / 5);
            const col = i % 5;
            const srcCol = Math.min(col, 4 - col);
            const bit = row * 3 + srcCol;
            return (
              <rect
                class="cell"
                data-bit={bit}
                x={col * 28.8}
                y={row * 28.8}
                width="28.8"
                height="28.8"
                fill="var(--accent)"
                opacity="0"
              />
            );
          })}
        </svg>
      </button>
    </div>

    <div class="mt-8 max-w-2xl space-y-4 text-base leading-relaxed rise rise-3" style="color: var(--muted);">
      <p>
        By day I'm on the observability team at Aptean, keeping monitoring
        pipelines, centralized logging and alerting honest across a large fleet
        of enterprise products — OpenTelemetry, Prometheus, Grafana, Loki,
        Kubernetes, and the production troubleshooting that comes with them.
        Lately that includes pulling AI into the workflow: natural-language
        interfaces over operational data, AI-assisted troubleshooting, and an
        LLM-powered SQL agent.
      </p>
      <p>
        The rest of the time I build. I run open-source models on GPU
        infrastructure (vLLM, LiteLLM, Ollama), maintain
        <a href="https://github.com/Nedjagang/magpie" class="link-quiet">Magpie</a> —
        an open-source control plane for OpenTelemetry collector fleets — and
        ship product experiments under InsightX Labs, which mostly means
        learning whatever the problem requires: backend architecture, Docker,
        reverse proxies, CI/CD, and the late-night production debugging that
        follows.
      </p>
      <p>
        Most of my projects start with “can an agent do this?”. Some become
        products; some should have stayed weekend experiments. I talk about the
        interesting ones on VeepTalks, and when I'm away from a terminal I'm
        usually out with a camera looking for birds.
      </p>
    </div>

    <div class="mt-8 rise rise-4">
      <ul class="space-y-2.5 text-sm" style="color: var(--muted);">
        <li class="flex items-center gap-2.5">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            <rect width="20" height="14" x="2" y="6" rx="2" />
          </svg>
          <span>{SITE.role}</span>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <span>{SITE.location}</span>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          <button id="copy-email" class="copy-email" type="button" title="Click to copy">
            <span>{email}</span>
          </button>
        </li>
      </ul>

      <div class="mt-5 flex flex-wrap gap-2.5">
        <a href={SITE.github} target="_blank" rel="noopener" class="social-chip">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          <span>GitHub</span>
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noopener" class="social-chip">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.56V9h3.554v11.452z" />
          </svg>
          <span>LinkedIn</span>
        </a>
        <a href={SITE.email} class="social-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="20" height="16" x="2" y="4" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          <span>Email</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .avatar {
    position: relative;
    display: none;
    width: 144px;
    height: 144px;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 200ms ease;
  }
  .avatar:hover {
    transform: scale(1.04);
  }
  .avatar-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid var(--border);
    transition: border-color 300ms ease;
  }
  .avatar:hover .avatar-grid {
    border-color: var(--accent);
  }
  .avatar-grid .cell {
    transition: opacity 250ms ease;
  }
  /* Spinning gold arcs on hover — single-accent take on the multicolor ring. */
  .avatar-ring {
    position: absolute;
    inset: -9px;
    border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--accent);
    border-bottom-color: var(--accent);
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .avatar:hover .avatar-ring {
    opacity: 1;
    animation: ring-spin 1.4s linear infinite;
  }
  @keyframes ring-spin {
    to { transform: rotate(360deg); }
  }
  .avatar.wobble {
    animation: wobble 700ms ease;
  }
  @keyframes wobble {
    0% { transform: rotate(0); }
    25% { transform: rotate(-10deg) scale(1.08); }
    50% { transform: rotate(8deg) scale(1.05); }
    75% { transform: rotate(-4deg); }
    100% { transform: rotate(0); }
  }
  @media (min-width: 640px) {
    .avatar { display: block; }
  }

  /* Hero composes itself on load: each block rises in, 80ms apart. */
  .rise {
    animation: rise 550ms cubic-bezier(0.25, 1, 0.5, 1) backwards;
  }
  .rise-2 { animation-delay: 80ms; }
  .rise-3 { animation-delay: 160ms; }
  .rise-4 { animation-delay: 240ms; }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  .contact-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }

  /* Email is click-to-copy; the "copied" state borrows the gold marker. */
  .copy-email {
    cursor: pointer;
    color: var(--ink);
    text-decoration: underline dotted;
    text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    border-radius: 2px;
    padding: 0 0.15em;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .copy-email:hover,
  .copy-email.copied {
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
  }

  .social-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease, transform 150ms ease;
  }
  .social-chip svg {
    width: 15px;
    height: 15px;
  }
  .social-chip:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-1px);
  }
</style>

<script>
  function initAvatar() {
    const avatar = document.getElementById('avatar');
    if (!avatar || avatar.dataset.wired) return;
    avatar.dataset.wired = 'true';
    avatar.addEventListener('click', () => {
      avatar.classList.remove('wobble');
      void avatar.offsetWidth; /* restart the animation on repeat clicks */
      avatar.classList.add('wobble');
    });
  }
  initAvatar();
  document.addEventListener('astro:page-load', initAvatar);

  // ponytail: string hash (not real md5) — good enough to seed a 15-bit pattern, no crypto needed for a decorative avatar.
  function hashSeed(str: string): number {
    let h = 0;
    for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0;
    return h >>> 0;
  }

  let gridTimer: ReturnType<typeof setInterval>;
  function tickGrid() {
    const cells = document.querySelectorAll<SVGRectElement>('#avatar-grid .cell');
    if (!cells.length) return;
    const seed = hashSeed(new Date().toISOString());
    cells.forEach((cell) => {
      const bit = Number(cell.dataset.bit);
      const on = ((seed >>> bit) & 1) === 1;
      cell.setAttribute('opacity', on ? '1' : '0');
    });
  }
  function initGrid() {
    clearInterval(gridTimer);
    tickGrid();
    gridTimer = setInterval(tickGrid, 1000);
  }
  initGrid();
  document.addEventListener('astro:page-load', initGrid);

  function initCopyEmail() {
    const btn = document.getElementById('copy-email');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = 'true';
    const label = btn.querySelector('span');
    const address = label?.textContent ?? '';
    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        return; /* clipboard blocked — mailto chip below still works */
      }
      btn.classList.add('copied');
      if (label) label.textContent = 'copied to clipboard!';
      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.classList.remove('copied');
        if (label) label.textContent = address;
      }, 1600);
    });
  }
  initCopyEmail();
  document.addEventListener('astro:page-load', initCopyEmail);
</script>
