---
// Usage in MDX: <Mermaid code={`graph TD; A-->B;`} />
// Kept as a plain Astro component + inline script rather than a React
// island: mermaid.js does its own DOM rendering, so there's nothing for
// React to manage here.
interface Props {
  code: string;
}
const { code } = Astro.props;
const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="not-prose my-6 overflow-x-auto rounded-lg border p-4" style="border-color: var(--border); background-color: var(--surface);">
  <pre class="mermaid-source" data-mermaid-id={id} style="display: none;">{code}</pre>
  <div id={id} class="mermaid-target flex justify-center"></div>
</div>

<script>
  async function renderAll() {
    const sources = document.querySelectorAll<HTMLElement>('.mermaid-source');
    if (sources.length === 0) return;
    const { default: mermaid } = await import('mermaid');
    const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
    mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default', securityLevel: 'strict' });
    for (const source of sources) {
      const id = source.dataset.mermaidId!;
      const target = document.getElementById(id);
      if (!target || target.dataset.rendered) continue;
      const { svg } = await mermaid.render(`${id}-svg`, source.textContent || '');
      target.innerHTML = svg;
      target.dataset.rendered = 'true';
    }
  }
  renderAll();
  document.addEventListener('astro:page-load', renderAll);
</script>
