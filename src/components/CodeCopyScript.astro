---
// Adds a copy button to every Shiki-rendered <pre> block in the article
// body. No clipboard library needed: navigator.clipboard.writeText is the
// standard API and has been for years.
---

<script>
  function addCopyButtons() {
    const blocks = document.querySelectorAll<HTMLPreElement>('.prose-body pre:not([data-copy-ready])');
    blocks.forEach((pre) => {
      pre.dataset.copyReady = 'true';
      const button = document.createElement('button');
      button.textContent = 'Copy';
      button.className = 'copy-btn';
      button.style.cssText =
        'position:absolute;top:0.5rem;right:0.5rem;font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;border:1px solid var(--border);background:var(--bg);color:var(--muted);cursor:pointer;';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent ?? '';
        await navigator.clipboard.writeText(code);
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = 'Copy'), 1500);
      });
      pre.appendChild(button);
    });
  }
  addCopyButtons();
  document.addEventListener('astro:page-load', addCopyButtons);
</script>
