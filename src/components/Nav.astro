---
import { SITE } from '../lib/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isWriting = pathname.startsWith('/writing');
const isProjects = pathname.startsWith('/projects');

const links = [
  { href: '/', label: 'About', active: isHome },
  { href: '/writing', label: 'Writing', active: isWriting },
  { href: '/projects', label: 'Projects', active: isProjects },
  { href: SITE.github, label: 'GitHub', external: true, active: false },
];
---

<header class="sticky top-0 z-40 border-b backdrop-blur" style="border-color: var(--border); background-color: color-mix(in srgb, var(--bg) 85%, transparent);">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="display text-xl tracking-tight" style="color: var(--ink);">
      {SITE.name}<span style="color: var(--accent);">.</span>
    </a>
    <div class="flex items-center gap-5 text-sm" style="color: var(--muted);">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
          aria-current={l.active ? 'page' : undefined}
          class:list={['hidden hover:text-[var(--accent)] sm:inline transition-colors', l.active && 'nav-active']}
        >{l.label}{l.external && <span class="ext-arrow" aria-hidden="true"> ↗</span>}</a>
      ))}
      <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Toggle light and dark theme">
        <svg class="theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
        </svg>
      </button>
    </div>
  </nav>
  <div class="flex gap-4 overflow-x-auto px-6 pb-3 text-sm sm:hidden" style="color: var(--muted);">
    {links.map((l) => (
      <a
        href={l.href}
        target={l.external ? '_blank' : undefined}
        rel={l.external ? 'noopener' : undefined}
        aria-current={l.active ? 'page' : undefined}
        class:list={['whitespace-nowrap', l.active && 'nav-active']}
      >{l.label}</a>
    ))}
  </div>
</header>

<style>
  .nav-active {
    position: relative;
    color: var(--ink);
    text-decoration: none;
  }
  .nav-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--accent);
    transform-origin: left;
    animation: nav-underline 350ms cubic-bezier(0.25, 1, 0.5, 1) both;
  }
  @keyframes nav-underline {
    from { transform: scaleX(0); }
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--muted);
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn || btn.dataset.wired) return;
    btn.dataset.wired = 'true';
    btn.addEventListener('click', () => {
      const resolved = document.documentElement.getAttribute('data-theme');
      const next = resolved === 'light' ? 'dark' : 'light';
      localStorage.setItem('theme', next);
      document.documentElement.setAttribute('data-theme', next);
      document.documentElement.setAttribute('data-theme-pref', next);
    });
  }
  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
